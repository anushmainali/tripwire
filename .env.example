# Copy to .env and fill in. Never commit .env.

# Factory Droid (optional if you've signed in with `droid`): https://docs.factory.com/sdk/python
FACTORY_API_KEY=

# Photon (Beta): https://photon.codes/docs/beta/get-started/project
# Key needs project:read and project:write
PHOTON_API_KEY=
PHOTON_PROJECT_ID=pho_prj_
PHOTON_PLATFORM=imessage
# Shared line number Photon assigned to your sender (E.164, e.g. +14155550188)
PHOTON_AGENT_HANDLE=
# Your own send-from phone number (E.164) or iMessage email
PHOTON_TEST_SENDER=

# Chalk service credentials (Dashboard > Settings > Access tokens): https://docs.chalk.ai/docs/online-authentication
CHALK_CLIENT_ID=
CHALK_CLIENT_SECRET=
CHALK_ENVIRONMENT=
# Optional; defaults to https://api.chalk.ai
CHALK_API_SERVER=
